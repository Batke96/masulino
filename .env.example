# Local development defaults. These are not production secrets.

# App runtime role: no superuser, no BYPASSRLS.
DATABASE_URL=postgresql://masulino_app:masulino_app_local@127.0.0.1:54329/masulino

# Better Auth role: identity schema only.
DATABASE_URL_AUTH=postgresql://masulino_auth:masulino_auth_local@127.0.0.1:54329/masulino

# Outbox drain role. Cron only.
DATABASE_URL_WORKER=postgresql://masulino_worker:masulino_worker_local@127.0.0.1:54329/masulino

# Migration/bootstrap role. Never configure this on the UI runtime.
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@127.0.0.1:54329/masulino

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-better-auth-secret-32chars
# Must match the Vite origin so proxied auth cookies stay same-site.
BETTER_AUTH_URL=http://localhost:5173

CRON_SECRET=local-dev-cron-secret-16

# Local seed refuses to run when NODE_ENV=production.
MASULINO_SEED_CONFIRM=synthetic

# Dev-only bypass. Leave unset so the staff UI requires a real session.
# Refused when NODE_ENV=production.
MASULINO_DEV_SESSION=0

# Password sign-in is the default for every role, including production.
# Set to 1 to require an authenticator for Inhaber, Verwaltung, IT, and Standortleitung.
MASULINO_REQUIRE_MFA=0

# Node adapter listen port (Vite proxies /api here).
MASULINO_API_PORT=8787
