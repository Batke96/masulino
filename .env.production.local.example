# Laptop-only Neon / Vercel operator values for pnpm staff:add (and similar).
# Copy to .env.production.local and fill in. Never commit .env.production.local.
# Local .env stays on 127.0.0.1 for pnpm dev:workspace.

# Neon production branch — pooling OFF (owner)
DATABASE_URL_MIGRATE=postgresql://neondb_owner:…@ep-….eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon production — pooling ON (role users)
DATABASE_URL=postgresql://masulino_app:…@ep-…-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_AUTH=postgresql://masulino_auth:…@ep-…-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_WORKER=postgresql://masulino_worker:…@ep-…-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Same values as Vercel Production
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-production-host.vercel.app
CRON_SECRET=
