# Laptop-only Neon / Vercel operator values for pnpm staff:add (and similar).
# Copy to .env.production.local and replace every REPLACE_* value with the real
# strings from Neon Connect / Vercel. Never commit .env.production.local.
# Local .env stays on 127.0.0.1 for pnpm dev:workspace.
#
# Use the same URLs you already used for migrate / bootstrap / Vercel.

# Neon production branch — pooling OFF (owner). Host must NOT contain -pooler.
DATABASE_URL_MIGRATE=postgresql://neondb_owner:REPLACE_OWNER_PASSWORD@REPLACE_DIRECT_HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon production — pooling ON. Host must contain -pooler. Same host for all three.
DATABASE_URL=postgresql://masulino_app:REPLACE_APP_PASSWORD@REPLACE_POOLER_HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_AUTH=postgresql://masulino_auth:REPLACE_AUTH_PASSWORD@REPLACE_POOLER_HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_WORKER=postgresql://masulino_worker:REPLACE_WORKER_PASSWORD@REPLACE_POOLER_HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Same values as Vercel Production
BETTER_AUTH_SECRET=REPLACE_BETTER_AUTH_SECRET
BETTER_AUTH_URL=https://REPLACE_VERCEL_HOST
CRON_SECRET=REPLACE_CRON_SECRET
